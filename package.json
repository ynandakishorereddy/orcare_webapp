    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "eslint": "^8.57.0",
